# ============================================
# 教学评价系统 V2 (Go) - 环境配置示例
# 复制此文件为 .env 并修改配置值
# ============================================

# 应用配置
APP_NAME="Teaching Evaluation System V2"
APP_VERSION="2.0.0"
DEBUG=false
PORT=8000

# 数据库配置 (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=teaching_eval_v2

# JWT 安全配置（生产环境必须改为随机强密钥，与旧后端共用同一密钥时可互通 token）
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 配置，逗号分隔（生产环境建议限制具体域名）
CORS_ORIGINS=*

# Cookie 安全设置（生产环境必须设为 true）
COOKIE_SECURE=false

# 教务系统爬虫（数据同步功能需要）
JWXT_USERNAME=
JWXT_PASSWORD=
JWXT_BASE_URL_XS=http://qzjw.bwgl.cn/gllgdxbwglxy_jsxsd
JWXT_BASE_URL_GL=http://qzjw.bwgl.cn/gllgdxbwglxy

# 同步创建教师的初始密码
DEFAULT_USER_PASSWORD=123456

# 文件上传目录
UPLOAD_DIR=uploads
