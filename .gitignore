# ============================================
# 南理教评系统  - Git Ignore 配置
# ============================================

# ----------------------------------------
# IDE 和编辑器
# ----------------------------------------
.idea/
.vscode/

# ----------------------------------------
# 工作区本地数据（AI 记忆 / 会话数据，不入库）
# ----------------------------------------
.workbuddy/
# AI 技能安装目录（由 skills-lock.json 锁定，可随时重装，不入库）
.agents/
*.swp
*.swo
.trae/
.pytest_cache/
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# ----------------------------------------
# 操作系统文件
# ----------------------------------------
Thumbs.db
.DS_Store
*.lnk

# ----------------------------------------
# 日志文件
# ----------------------------------------
*.log
logs/
log/
# vendor 依赖树必须完整入库;上方 logs/ 规则会吞掉 vendored 的 internal/maintnotifications/logs,
# 放行规则必须带正确的前缀（vendor 位于 backend-go/vendor,而非仓库根）
!**/vendor/github.com/redis/go-redis/v9/internal/maintnotifications/logs/
!**/vendor/github.com/redis/go-redis/v9/internal/maintnotifications/logs/**

# ----------------------------------------
# 环境配置文件
# ----------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# ----------------------------------------
# 依赖目录
# ----------------------------------------
node_modules/
venv/
# 仅忽略根目录的虚拟环境目录（不加 / 会因 Windows 大小写不敏感误伤 vendor 下的 env/ 等同名目录）
/env/
/ENV/
.venv/
__pycache__/

# ----------------------------------------
# 构建输出
# ----------------------------------------
dist/
build/
/server
server.exe
*.tsbuildinfo
*.egg-info/
.pytest_cache/
.mypy_cache/

# ----------------------------------------
# 数据库文件
# ----------------------------------------
*.db
*.sqlite
*.sqlite3

# ----------------------------------------
# 上传文件和临时文件
# ----------------------------------------
uploads/
temp/
tmp/
*.tmp

# ----------------------------------------
# 测试覆盖率报告
# ----------------------------------------
coverage/
htmlcov/
.coverage
.coverage.*

# ----------------------------------------
# 其他
# ----------------------------------------
*.bak
*.backup
cookies.txt
*.xls
*.xlsx
